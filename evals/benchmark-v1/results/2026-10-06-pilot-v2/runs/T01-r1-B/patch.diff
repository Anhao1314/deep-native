+"""Regression tests for ``boltons.strutils.ordinalize``.
+
+These cover the regression where the "teens" check keyed off the tens
+digit being ``'2'`` (the twenties) instead of ``'1'`` (10-19).  Symptoms:
+teens such as 11/12/13 came out as ``11st``/``12nd``/``13rd``, while
+numbers ending in 21/22/23 (and 121/122/123, 211/212/213, ...) came out
+as ``21th``/``22th``/``23th``.
+"""
+import unittest
+
+from boltons.strutils import ordinalize
+
+
+def _reference_suffix(number):
+    """Independent restatement of the English ordinal-suffix rule.
+
+    The final two digits 10-19 all take "th"; otherwise the suffix follows
+    the final digit (1 -> st, 2 -> nd, 3 -> rd, everything else -> th).
+    """
+    numstr = str(number)
+    if numstr[-2:] in ('11', '12', '13'):
+        return 'th'
+    return {'1': 'st', '2': 'nd', '3': 'rd'}.get(numstr[-1], 'th')
+
+
+class OrdinalizeTeenTests(unittest.TestCase):
+    def test_teens_all_end_in_th(self):
+        for n in range(10, 20):
+            self.assertEqual(ordinalize(n), '%dth' % n)
+            self.assertEqual(ordinalize(n, ext_only=True), 'th')
+
+    def test_teen_tails_of_larger_numbers(self):
+        for n in (111, 112, 113, 211, 212, 213, 1011, 1012, 1013, 999111):
+            self.assertEqual(ordinalize(n), '%dth' % n)
+            self.assertEqual(ordinalize(n, ext_only=True), 'th')
+
+
+class OrdinalizeTwentiesTests(unittest.TestCase):
+    def test_twenty_through_twenty_nine(self):
+        expected = {20: '20th', 21: '21st', 22: '22nd', 23: '23rd',
+                    24: '24th', 25: '25th', 26: '26th', 27: '27th',
+                    28: '28th', 29: '29th'}
+        for n, want in expected.items():
+            self.assertEqual(ordinalize(n), want)
+            self.assertEqual(ordinalize(n, ext_only=True), want[-2:])
+
+    def test_twenties_tail_is_not_special_cased(self):
+        # A tens digit of 2 must not force "th"; the final digit decides
+        # unless the final two digits are 10-19.
+        for n in (121, 122, 123, 221, 222, 223, 1121, 1122, 1123):
+            self.assertEqual(ordinalize(n), str(n) + _reference_suffix(n))
+            self.assertEqual(ordinalize(n, ext_only=True),
+                             _reference_suffix(n))
+
+
+class OrdinalizeGeneralTests(unittest.TestCase):
+    def test_sweep_matches_reference_rule(self):
+        cases = list(range(0, 1001))
+        cases += [1515, 3694839230, 10 ** 9 + 11, 10 ** 9 + 22, 10 ** 12 + 13]
+        for n in cases:
+            self.assertEqual(ordinalize(n), str(n) + _reference_suffix(n), n)
+            self.assertEqual(ordinalize(n, ext_only=True),
+                             _reference_suffix(n), n)
+
+    def test_string_inputs(self):
+        self.assertEqual(ordinalize('11'), '11th')
+        self.assertEqual(ordinalize('22'), '22nd')
+        self.assertEqual(ordinalize('121'), '121st')
+        self.assertEqual(ordinalize('22', ext_only=True), 'nd')
+        self.assertEqual(ordinalize('11', ext_only=True), 'th')
+
+    def test_non_digit_ending_returned_unchanged(self):
+        for value in ('', 'hi', 'foo!', 'abc123x', 'twenty one'):
+            self.assertEqual(ordinalize(value), value)
+            self.assertEqual(ordinalize(value, ext_only=True), '')
+
+    def test_existing_behavior_preserved(self):
+        self.assertEqual(ordinalize(1), '1st')
+        self.assertEqual(ordinalize(2), '2nd')
+        self.assertEqual(ordinalize(3), '3rd')
+        self.assertEqual(ordinalize(4), '4th')
+        self.assertEqual(ordinalize(10), '10th')
+        self.assertEqual(ordinalize(1515), '1515th')
+        self.assertEqual(ordinalize(3694839230), '3694839230th')
+        self.assertEqual(ordinalize('hi'), 'hi')
+        self.assertEqual(ordinalize(1, ext_only=True), 'st')
+        self.assertEqual(ordinalize('hi', ext_only=True), '')
+
+
+if __name__ == '__main__':
+    unittest.main()
