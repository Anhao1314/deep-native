+"""Regression tests for boltons.iterutils.get_path.
+
+Covers the fix where later path segments were looked up on the outer
+*root* object instead of the value reached by the preceding segments.
+Also pins down the preserved behaviors: dotted list-index paths, tuple
+paths, ``default`` handling, and ``PathAccessError`` details.
+"""
+
+import unittest
+
+from boltons.iterutils import PathAccessError, get_path
+
+
+class TestGetPathNestedLookup(unittest.TestCase):
+    def test_nested_mapping_traverses_inward(self):
+        root = {'a': {'b': 7}}
+        self.assertEqual(get_path(root, ('a', 'b')), 7)
+        self.assertEqual(get_path(root, 'a.b'), 7)
+
+    def test_later_segment_not_resolved_at_root(self):
+        # 'b' also exists at the outer root; the nested value must win.
+        root = {'a': {'b': 1}, 'b': 2}
+        self.assertEqual(get_path(root, ('a', 'b')), 1)
+        self.assertEqual(get_path(root, 'a.b'), 1)
+
+    def test_repeated_key_at_multiple_depths(self):
+        root = {'a': {'a': {'a': 'deep'}}}
+        self.assertEqual(get_path(root, ('a', 'a', 'a')), 'deep')
+
+    def test_deep_mixed_nesting(self):
+        root = {'a': {'b': {'c': [[1], [2], [3]]}}}
+        self.assertEqual(get_path(root, ('a', 'b', 'c', 2, 0)), 3)
+
+    def test_string_leaf_indexing(self):
+        self.assertEqual(get_path({'a': 'bcd'}, ('a', 1)), 'c')
+
+
+class TestGetPathDottedListIndex(unittest.TestCase):
+    def test_dotted_index_into_nested_list(self):
+        root = {'key': ['test']}
+        self.assertEqual(get_path(root, 'key.0'), 'test')
+
+    def test_dotted_multi_digit_index(self):
+        root = {'a': {'b': list(range(12))}}
+        self.assertEqual(get_path(root, 'a.b.10'), 10)
+
+    def test_dotted_index_then_key(self):
+        root = {'key': [{'x': 'deep'}]}
+        self.assertEqual(get_path(root, 'key.0.x'), 'deep')
+
+
+class TestGetPathTuplesAndDefaults(unittest.TestCase):
+    def test_tuple_int_path(self):
+        root = {'a': {'b': [1, 2, 3]}}
+        self.assertEqual(get_path(root, ('a', 'b', 2)), 3)
+
+    def test_default_for_missing_nested_key(self):
+        root = {'a': {'b': 7}}
+        self.assertIsNone(get_path(root, ('a', 'z'), default=None))
+        self.assertEqual(get_path(root, 'a.z', default='dflt'), 'dflt')
+
+    def test_default_for_missing_outer_key(self):
+        self.assertEqual(get_path({'a': 1}, ('z',), default='dflt'), 'dflt')
+
+    def test_default_for_out_of_range_index(self):
+        root = {'a': {'b': [1]}}
+        self.assertEqual(get_path(root, ('a', 'b', 5), default='dflt'), 'dflt')
+        self.assertEqual(get_path({'key': []}, 'key.0', default='dflt'),
+                         'dflt')
+
+    def test_default_not_used_on_success(self):
+        root = {'a': {'b': 7}}
+        self.assertEqual(get_path(root, ('a', 'b'), default='dflt'), 7)
+
+    def test_default_does_not_mask_outer_path(self):
+        # The inner 'b' must be found even though the root also has 'b'.
+        root = {'a': {'b': 1}, 'b': 2}
+        self.assertEqual(get_path(root, 'a.b', default='dflt'), 1)
+
+
+class TestGetPathErrorDetails(unittest.TestCase):
+    def test_nested_key_error_details(self):
+        root = {'a': {'b': 7}}
+        with self.assertRaises(PathAccessError) as ctx:
+            get_path(root, ('a', 'zzz'))
+        exc = ctx.exception
+        self.assertIsInstance(exc, KeyError)
+        self.assertIsInstance(exc, IndexError)
+        self.assertIsInstance(exc, TypeError)
+        self.assertEqual(exc.seg, 'zzz')
+        self.assertEqual(exc.path, ('a', 'zzz'))
+        self.assertIsInstance(exc.exc, KeyError)
+        self.assertIn('zzz', str(exc))
+        self.assertIn("('a', 'zzz')", str(exc))
+        self.assertEqual(repr(exc),
+                         "PathAccessError(KeyError('zzz'), 'zzz', "
+                         "('a', 'zzz'))")
+
+    def test_nested_index_error_details(self):
+        root = {'a': {'b': [1]}}
+        with self.assertRaises(PathAccessError) as ctx:
+            get_path(root, ('a', 'b', 5))
+        exc = ctx.exception
+        self.assertEqual(exc.seg, 5)
+        self.assertEqual(exc.path, ('a', 'b', 5))
+        self.assertIsInstance(exc.exc, IndexError)
+
+    def test_dotted_path_error_reports_segments(self):
+        root = {'a': {'b': 7}}
+        with self.assertRaises(PathAccessError) as ctx:
+            get_path(root, 'a.zzz')
+        exc = ctx.exception
+        self.assertEqual(exc.seg, 'zzz')
+        self.assertEqual(exc.path, ['a', 'zzz'])
+        self.assertIsInstance(exc.exc, KeyError)
+
+    def test_non_indexable_parent_error_details(self):
+        with self.assertRaises(PathAccessError) as ctx:
+            get_path({'a': 5}, ('a', 'b'))
+        exc = ctx.exception
+        self.assertEqual(exc.seg, 'b')
+        self.assertEqual(exc.path, ('a', 'b'))
+        self.assertIsInstance(exc.exc, TypeError)
+        self.assertIn('not indexable', str(exc))
+
+
+if __name__ == '__main__':
+    unittest.main()
