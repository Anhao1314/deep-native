--- /dev/null
+++ b/agent_tests/test_parse_int_list.py
@@ -0,0 +1,193 @@
+"""Regression tests for signed integers and signed inclusive ranges in
+:func:`boltons.strutils.parse_int_list`.
+
+Covers omitted existing behaviors too (sorting, duplicates, empty
+input, literal delimiters) so the extension cannot silently regress
+them.
+"""
+
+import doctest
+import unittest
+
+from boltons.strutils import parse_int_list
+
+
+class SignedIntegerTestCase(unittest.TestCase):
+    def test_positive_sign(self):
+        self.assertEqual(parse_int_list('+2'), [2])
+
+    def test_negative_integer(self):
+        self.assertEqual(parse_int_list('-3'), [-3])
+
+    def test_mixed_signs_are_sorted(self):
+        self.assertEqual(parse_int_list('+2,-3,0,+4,-1'), [-3, -1, 0, 2, 4])
+
+    def test_signed_integer_with_custom_delim(self):
+        self.assertEqual(parse_int_list('+2;-3', delim=';'), [-3, 2])
+
+
+class SignedRangeTestCase(unittest.TestCase):
+    def test_negative_range(self):
+        self.assertEqual(parse_int_list('-3--1'), [-3, -2, -1])
+
+    def test_positive_sign_range(self):
+        self.assertEqual(parse_int_list('+2-+4'), [2, 3, 4])
+
+    def test_range_crossing_zero(self):
+        self.assertEqual(parse_int_list('-2-+2'), [-2, -1, 0, 1, 2])
+
+    def test_signed_ranges_combined(self):
+        self.assertEqual(parse_int_list('-3--1,+2-+4'), [-3, -2, -1, 2, 3, 4])
+
+    def test_single_element_range(self):
+        self.assertEqual(parse_int_list('-5--5'), [-5])
+
+    def test_signed_range_with_custom_range_delim(self):
+        self.assertEqual(parse_int_list('-3~-1', range_delim='~'), [-3, -2, -1])
+
+
+class ReversedEndpointTestCase(unittest.TestCase):
+    def test_reversed_positive_endpoints(self):
+        self.assertEqual(parse_int_list('4-2'), [2, 3, 4])
+
+    def test_reversed_negative_endpoints(self):
+        self.assertEqual(parse_int_list('-1--3'), [-3, -2, -1])
+
+    def test_reversed_signed_endpoints(self):
+        self.assertEqual(parse_int_list('+4-+2'), [2, 3, 4])
+
+    def test_reversed_endpoints_crossing_zero(self):
+        self.assertEqual(parse_int_list('2--2'), [-2, -1, 0, 1, 2])
+
+
+class WhitespaceTestCase(unittest.TestCase):
+    def test_whitespace_around_tokens(self):
+        self.assertEqual(parse_int_list(' 1 , 3 , 5 '), [1, 3, 5])
+
+    def test_whitespace_around_range_endpoints(self):
+        self.assertEqual(parse_int_list('1 , 5 - 8 , 10'),
+                         [1, 5, 6, 7, 8, 10])
+
+    def test_whitespace_around_signed_endpoints(self):
+        self.assertEqual(parse_int_list(' -3 - -1 , +2 - +4 '),
+                         [-3, -2, -1, 2, 3, 4])
+
+    def test_whitespace_with_signed_endpoints_and_custom_delims(self):
+        self.assertEqual(parse_int_list(' 1 ; -3 ~ -1 ', delim=';',
+                                        range_delim='~'),
+                         [-3, -2, -1, 1])
+
+    def test_whitespace_only_token_is_ignored(self):
+        self.assertEqual(parse_int_list('1, ,2'), [1, 2])
+
+    def test_whitespace_only_input_is_empty(self):
+        self.assertEqual(parse_int_list('   '), [])
+
+
+class PreservedBehaviorTestCase(unittest.TestCase):
+    def test_result_is_sorted(self):
+        self.assertEqual(parse_int_list('5,1,3'), [1, 3, 5])
+
+    def test_duplicates_are_preserved(self):
+        self.assertEqual(parse_int_list('1,1,2-3,3'), [1, 1, 2, 3, 3])
+
+    def test_signed_duplicates_are_preserved(self):
+        self.assertEqual(parse_int_list('-1,-1,+2'), [-1, -1, 2])
+
+    def test_empty_input(self):
+        self.assertEqual(parse_int_list(''), [])
+
+    def test_delimiters_only_input(self):
+        self.assertEqual(parse_int_list(',,,'), [])
+
+    def test_range_expansion(self):
+        self.assertEqual(parse_int_list('1,3,5-8,10-11,15'),
+                         [1, 3, 5, 6, 7, 8, 10, 11, 15])
+
+    def test_empty_tokens_are_ignored(self):
+        self.assertEqual(parse_int_list(',1,3,5-8,'), [1, 3, 5, 6, 7, 8])
+
+
+class CustomLiteralDelimiterTestCase(unittest.TestCase):
+    def test_custom_delim(self):
+        self.assertEqual(parse_int_list('1;3;5-8', delim=';'),
+                         [1, 3, 5, 6, 7, 8])
+
+    def test_custom_range_delim(self):
+        self.assertEqual(parse_int_list('1,3,5~8', range_delim='~'),
+                         [1, 3, 5, 6, 7, 8])
+
+    def test_multi_character_delim(self):
+        self.assertEqual(parse_int_list('1;;3;;-2', delim=';;'), [-2, 1, 3])
+
+    def test_multi_character_range_delim(self):
+        self.assertEqual(parse_int_list('1,5..7', range_delim='..'),
+                         [1, 5, 6, 7])
+
+    def test_regex_special_range_delim_is_literal(self):
+        self.assertEqual(parse_int_list('1,-3.-1', range_delim='.'),
+                         [-3, -2, -1, 1])
+
+    def test_regex_special_delim_is_literal(self):
+        self.assertEqual(parse_int_list('1.3.-3--1', delim='.'),
+                         [-3, -2, -1, 1, 3])
+
+    def test_delim_containing_whitespace_is_literal(self):
+        self.assertEqual(parse_int_list('1, 3, -3--1', delim=', '),
+                         [-3, -2, -1, 1, 3])
+
+    def test_custom_delims_with_signed_ranges(self):
+        self.assertEqual(parse_int_list('-3--1;+2-+4', delim=';'),
+                         [-3, -2, -1, 2, 3, 4])
+
+
+class MalformedRangeTestCase(unittest.TestCase):
+    def assertMalformed(self, range_string, **kwargs):
+        with self.assertRaises(ValueError):
+            parse_int_list(range_string, **kwargs)
+
+    def test_missing_endpoint(self):
+        self.assertMalformed('1-')
+        self.assertMalformed('-1-')
+
+    def test_lone_range_delim(self):
+        self.assertMalformed('-')
+
+    def test_double_range_delim(self):
+        self.assertMalformed('1--')
+
+    def test_too_many_endpoints(self):
+        self.assertMalformed('1-2-3')
+
+    def test_repeated_leading_sign(self):
+        self.assertMalformed('--3')
+        self.assertMalformed('++3')
+
+    def test_lone_sign(self):
+        self.assertMalformed('+')
+
+    def test_non_numeric(self):
+        self.assertMalformed('a')
+        self.assertMalformed('1-a')
+
+    def test_dangling_sign_after_range_delim(self):
+        self.assertMalformed('1-+')
+
+    def test_malformed_inside_valid_list(self):
+        self.assertMalformed('1,2-')
+
+    def test_malformed_with_custom_range_delim(self):
+        self.assertMalformed('1~', range_delim='~')
+
+
+class DocstringTestCase(unittest.TestCase):
+    def test_docstring_examples(self):
+        runner = doctest.DocTestRunner()
+        for test in doctest.DocTestFinder().find(parse_int_list):
+            runner.run(test)
+        self.assertGreater(runner.tries, 0)
+        self.assertEqual(runner.failures, 0)
+
+
+if __name__ == '__main__':
+    unittest.main()
