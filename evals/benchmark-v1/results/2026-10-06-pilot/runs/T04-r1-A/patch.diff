--- /dev/null
+++ b/agent_tests/test_parse_int_list_signed.py
@@ -0,0 +1,208 @@
+"""Regression tests for signed integer support in strutils.parse_int_list."""
+
+import unittest
+
+from boltons.strutils import parse_int_list
+
+
+class ParseIntListTestCase(unittest.TestCase):
+    def assertParses(self, range_string, expected, **kwargs):
+        self.assertEqual(parse_int_list(range_string, **kwargs), expected)
+
+    def assertInvalid(self, range_string, **kwargs):
+        with self.assertRaises(ValueError):
+            parse_int_list(range_string, **kwargs)
+
+
+class TestSignedIntegers(ParseIntListTestCase):
+    def test_negative_integer(self):
+        self.assertParses('-3', [-3])
+
+    def test_explicitly_positive_integer(self):
+        self.assertParses('+2', [2])
+
+    def test_zero(self):
+        self.assertParses('0', [0])
+        self.assertParses('-0', [0])
+        self.assertParses('+0', [0])
+
+    def test_mixed_signed_integers(self):
+        self.assertParses('-3,-1', [-3, -1])
+        self.assertParses('3,-1,+2', [-1, 2, 3])
+        self.assertParses('-10,+10', [-10, 10])
+
+
+class TestSignedRanges(ParseIntListTestCase):
+    def test_negative_range(self):
+        self.assertParses('-3--1', [-3, -2, -1])
+
+    def test_explicitly_positive_range(self):
+        self.assertParses('+2-+4', [2, 3, 4])
+
+    def test_negative_and_positive_ranges(self):
+        self.assertParses('-3--1,+2-+4', [-3, -2, -1, 2, 3, 4])
+
+    def test_range_crossing_zero(self):
+        self.assertParses('-1-1', [-1, 0, 1])
+        self.assertParses('1--3', [-3, -2, -1, 0, 1])
+        self.assertParses('0--2', [-2, -1, 0])
+
+    def test_range_with_negative_start_only(self):
+        self.assertParses('-5-2', [-5, -4, -3, -2, -1, 0, 1, 2])
+
+    def test_range_with_equal_endpoints(self):
+        self.assertParses('-5--5', [-5])
+        self.assertParses('+3-+3', [3])
+        self.assertParses('0-0', [0])
+
+
+class TestReversedEndpoints(ParseIntListTestCase):
+    def test_reversed_positive_range(self):
+        self.assertParses('8-5', [5, 6, 7, 8])
+        self.assertParses('3-1', [1, 2, 3])
+
+    def test_reversed_negative_range(self):
+        self.assertParses('-1--3', [-3, -2, -1])
+
+    def test_reversed_explicitly_positive_range(self):
+        self.assertParses('+4-+2', [2, 3, 4])
+
+    def test_reversed_range_crossing_zero(self):
+        self.assertParses('1--1', [-1, 0, 1])
+        self.assertParses('2--2', [-2, -1, 0, 1, 2])
+
+
+class TestWhitespace(ParseIntListTestCase):
+    def test_whitespace_around_tokens(self):
+        self.assertParses(' 1 , 3 , 5-8 ', [1, 3, 5, 6, 7, 8])
+
+    def test_whitespace_around_signed_tokens(self):
+        self.assertParses(' -3 , +2 ', [-3, 2])
+
+    def test_whitespace_around_range_endpoints(self):
+        self.assertParses('-3 - -1', [-3, -2, -1])
+        self.assertParses('1 - 3', [1, 2, 3])
+        self.assertParses('+2 - +4', [2, 3, 4])
+        self.assertParses(' 8 - 5 ', [5, 6, 7, 8])
+
+    def test_whitespace_everywhere(self):
+        self.assertParses(' -3--1 , +2-+4 ', [-3, -2, -1, 2, 3, 4])
+        self.assertParses(' -3 - -1 , +2 - +4 ', [-3, -2, -1, 2, 3, 4])
+
+    def test_non_space_whitespace(self):
+        self.assertParses('3\t-\t1', [1, 2, 3])
+        self.assertParses('\n-3--1\n', [-3, -2, -1])
+
+
+class TestSortingAndDuplicates(ParseIntListTestCase):
+    def test_result_is_sorted(self):
+        self.assertParses('3,1,5-8,10-11,15', [1, 3, 5, 6, 7, 8, 10, 11, 15])
+        self.assertParses('3,-1,+2', [-1, 2, 3])
+        self.assertParses('-1--3,+2-+4', [-3, -2, -1, 2, 3, 4])
+
+    def test_duplicate_integers_preserved(self):
+        self.assertParses('1,1,1', [1, 1, 1])
+        self.assertParses('2,1,2', [1, 2, 2])
+        self.assertParses('-1,1,-2,1', [-2, -1, 1, 1])
+
+    def test_duplicates_across_ranges_preserved(self):
+        self.assertParses('1-3,2-4', [1, 2, 2, 3, 3, 4])
+        self.assertParses('5-8,8-5', [5, 5, 6, 6, 7, 7, 8, 8])
+        self.assertParses('-1--3,-2', [-3, -2, -2, -1])
+
+
+class TestEmptyInput(ParseIntListTestCase):
+    def test_empty_string(self):
+        self.assertParses('', [])
+
+    def test_whitespace_only_string(self):
+        self.assertParses('   ', [])
+        self.assertParses('\t\n', [])
+
+    def test_only_delimiters(self):
+        self.assertParses(',', [])
+        self.assertParses(' , ', [])
+        self.assertParses(',,,', [])
+        self.assertParses('1,', [1])
+        self.assertParses(',1', [1])
+
+    def test_only_custom_delimiters(self):
+        self.assertParses(';;', [], delim=';')
+        self.assertParses(' ; ; ', [], delim=';')
+
+
+class TestCustomDelimiters(ParseIntListTestCase):
+    def test_custom_token_delimiter(self):
+        self.assertParses('1;3;5-8', [1, 3, 5, 6, 7, 8], delim=';')
+        self.assertParses(' 1 ; 3 ; 5 ', [1, 3, 5], delim=';')
+
+    def test_custom_range_delimiter(self):
+        self.assertParses('1,3..5', [1, 3, 4, 5], range_delim='..')
+        self.assertParses('1,3|5', [1, 3, 4, 5], range_delim='|')
+
+    def test_custom_delimiters_together(self):
+        self.assertParses('1;3..8', [1, 3, 4, 5, 6, 7, 8],
+                          delim=';', range_delim='..')
+        self.assertParses('-3..-1;+2..+4', [-3, -2, -1, 2, 3, 4],
+                          delim=';', range_delim='..')
+
+    def test_custom_range_delimiter_with_signs(self):
+        self.assertParses('-3to-1,+2to+4', [-3, -2, -1, 2, 3, 4],
+                          range_delim='to')
+        self.assertParses('-3 | -1 ; +2 | +4', [-3, -2, -1, 2, 3, 4],
+                          delim=';', range_delim='|')
+
+    def test_custom_range_delimiter_reversed(self):
+        self.assertParses('8..5', [5, 6, 7, 8], range_delim='..')
+
+    def test_multi_character_token_delimiter(self):
+        self.assertParses('1 and 3 and 5', [1, 3, 5], delim=' and ')
+
+    def test_custom_delimiter_with_empty_tokens(self):
+        self.assertParses(';1;3;;5;', [1, 3, 5], delim=';')
+
+
+class TestMalformedRanges(ParseIntListTestCase):
+    def test_incomplete_range(self):
+        self.assertInvalid('1-')
+        self.assertInvalid('-3--')
+        self.assertInvalid('-')
+        self.assertInvalid('+')
+
+    def test_dangling_sign(self):
+        self.assertInvalid('--1')
+        self.assertInvalid('++1')
+        self.assertInvalid('1-+')
+        self.assertInvalid('1--')
+
+    def test_too_many_endpoints(self):
+        self.assertInvalid('1-2-3')
+        self.assertInvalid('-1-2-3')
+        self.assertInvalid('1--2--3')
+        self.assertInvalid('+2-+4-+6')
+        self.assertInvalid('1|3|5', range_delim='|')
+
+    def test_non_integer_tokens(self):
+        self.assertInvalid('a')
+        self.assertInvalid('1-a')
+        self.assertInvalid('a-1')
+        self.assertInvalid('1.5')
+        self.assertInvalid('1..3')
+
+    def test_malformed_token_among_valid_ones(self):
+        self.assertInvalid('1,2,bad')
+        self.assertInvalid('1-3,2-x')
+
+    def test_whitespace_inside_number(self):
+        self.assertInvalid('- 3')
+        self.assertInvalid('3 -1-')
+
+    def test_malformed_with_custom_delimiters(self):
+        self.assertInvalid('1;3..', delim=';', range_delim='..')
+        self.assertInvalid('1..3..5', range_delim='..')
+        self.assertInvalid('-3...-1', range_delim='..')
+        self.assertInvalid('1-2', range_delim='..')
+
+
+if __name__ == '__main__':
+    unittest.main()
